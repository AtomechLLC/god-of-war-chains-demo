; =====================================================================
; combatLand2.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combatLand2/
  clipId          72            ; [real] ANM_hero.bin act id
  duration        0.5333s       ; [real] 16 frames @30
  blendIn         0s        ; [real] act header +0x04 (hard cut)
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x64440       ; [real] offset in ANM_hero.bin

/Combat/goHero/combatLand2/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.11s        ; input buffered from here
  branchPoint     0.37s        ; queued branch executes
  cancelOpens     0.27s        ; L1 block-cancel window

/Combat/goHero/combatLand2/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.27..0.53]s  [inferred]  ; block-cancel recovery
