; =====================================================================
; berComboH1.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berComboH1/
  clipId          33            ; [real] ANM_hero.bin act id
  duration        1.9000s       ; [real] 57 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x2FDC0       ; [real] offset in ANM_hero.bin

/Combat/goHero/berComboH1/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.38s        ; input buffered from here
  branchPoint     1.33s        ; queued branch executes
  cancelOpens     0.95s        ; L1 block-cancel window

/Combat/goHero/berComboH1/Branches/
  branch  input=SQUARE         -> berComboH2       queueWindow=[0.38..1.90]s  targetDur=2.067s  [real-topology]  ; rage H2
  branch  input=TRIANGLE       -> berComboStab     queueWindow=[0.38..1.90]s  targetDur=1.700s  [inferred]  ; rage stab finisher
  cancel  input=L1             -> block            window=[0.95..1.90]s  [inferred]  ; block-cancel recovery
