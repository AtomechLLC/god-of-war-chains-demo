; =====================================================================
; berAirH2.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berAirH2/
  clipId          23            ; [real] ANM_hero.bin act id
  duration        0.8333s       ; [real] 25 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x26D00       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/berAirH2/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.17s        ; input buffered from here
  branchPoint     0.58s        ; queued branch executes
  cancelOpens     0.42s        ; L1 block-cancel window

/Combat/goHero/berAirH2/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.42..0.83]s  [inferred]  ; block-cancel recovery
