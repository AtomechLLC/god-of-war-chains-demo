; =====================================================================
; berserkExit.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berserkExit/
  clipId          28            ; [real] ANM_hero.bin act id
  duration        0.3333s       ; [real] 10 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x2C640       ; [real] offset in ANM_hero.bin

/Combat/goHero/berserkExit/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.07s        ; input buffered from here
  branchPoint     0.23s        ; queued branch executes
  cancelOpens     0.17s        ; L1 block-cancel window

/Combat/goHero/berserkExit/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.17..0.33]s  [inferred]  ; block-cancel recovery
