; =====================================================================
; combo6A.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combo6A/
  clipId          85            ; [real] ANM_hero.bin act id
  duration        1.4333s       ; [real] 43 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x89D40       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/combo6A/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.29s        ; input buffered from here
  branchPoint     1.00s        ; queued branch executes
  cancelOpens     0.72s        ; L1 block-cancel window

/Combat/goHero/combo6A/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.72..1.43]s  [inferred]  ; block-cancel recovery
