; =====================================================================
; combo3D.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combo3D/
  clipId          76            ; [real] ANM_hero.bin act id
  duration        1.5000s       ; [real] 45 frames @30
  blendIn         0.09s        ; [real] act header +0x04
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x710C0       ; [real] offset in ANM_hero.bin

/Combat/goHero/combo3D/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.30s        ; input buffered from here
  branchPoint     1.05s        ; queued branch executes
  cancelOpens     0.75s        ; L1 block-cancel window

/Combat/goHero/combo3D/Branches/
  branch  input=SQUARE         -> combo3E          queueWindow=[0.30..1.50]s  targetDur=1.600s  [real-topology]  ; light chain 5
  branch  input=TRIANGLE       -> comboJump        queueWindow=[0.30..1.50]s  targetDur=1.667s  [inferred]  ; jumping finisher
  cancel  input=L1             -> block            window=[0.75..1.50]s  [inferred]  ; block-cancel recovery
