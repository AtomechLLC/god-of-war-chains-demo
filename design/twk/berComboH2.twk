  clipId          34            ; [real] ANM_hero.bin act id
  duration        2.0667s       ; [real] 62 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x311C0       ; [real] offset in ANM_hero.bin

/Combat/goHero/berComboH2/Windows/          ; [inferred] adjustable model —
