; =====================================================================
; comboJump.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/comboJump/
  clipId          87            ; [real] ANM_hero.bin act id
  duration        1.6667s       ; [real] 50 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x8ED40       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/comboJump/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.33s        ; input buffered from here
  branchPoint     1.17s        ; queued branch executes
  cancelOpens     0.83s        ; L1 block-cancel window

/Combat/goHero/comboJump/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.83..1.67]s  [inferred]  ; block-cancel recovery
