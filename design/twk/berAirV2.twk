; =====================================================================
; berAirV2.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berAirV2/
  clipId          25            ; [real] ANM_hero.bin act id
  duration        0.6000s       ; [real] 18 frames @30
  blendIn         0.09s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x29000       ; [real] offset in ANM_hero.bin
  autoNext        berAirV2Land   ; follow-up clip

/Combat/goHero/berAirV2/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.12s        ; input buffered from here
  branchPoint     0.42s        ; queued branch executes
  cancelOpens     0.30s        ; L1 block-cancel window

/Combat/goHero/berAirV2/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.30..0.60]s  [inferred]  ; block-cancel recovery
