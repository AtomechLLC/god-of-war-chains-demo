; =====================================================================
; berserkEnter.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berserkEnter/
  clipId          27            ; [real] ANM_hero.bin act id
  duration        0.9333s       ; [real] 28 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x2B2C0       ; [real] offset in ANM_hero.bin
  autoNext        berserkIdle   ; follow-up clip

/Combat/goHero/berserkEnter/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.19s        ; input buffered from here
  branchPoint     0.65s        ; queued branch executes
  cancelOpens     0.47s        ; L1 block-cancel window

/Combat/goHero/berserkEnter/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.47..0.93]s  [inferred]  ; block-cancel recovery
