; =====================================================================
; berComboV4.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berComboV4/
  clipId          41            ; [real] ANM_hero.bin act id
  duration        2.1000s       ; [real] 63 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x3C180       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/berComboV4/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.42s        ; input buffered from here
  branchPoint     1.47s        ; queued branch executes
  cancelOpens     1.05s        ; L1 block-cancel window

/Combat/goHero/berComboV4/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[1.05..2.10]s  [inferred]  ; block-cancel recovery
