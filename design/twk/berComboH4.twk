; =====================================================================
; berComboH4.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berComboH4/
  clipId          36            ; [real] ANM_hero.bin act id
  duration        2.1667s       ; [real] 65 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x340C0       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/berComboH4/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.43s        ; input buffered from here
  branchPoint     1.52s        ; queued branch executes
  cancelOpens     1.08s        ; L1 block-cancel window

/Combat/goHero/berComboH4/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[1.08..2.17]s  [inferred]  ; block-cancel recovery
