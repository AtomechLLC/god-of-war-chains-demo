; =====================================================================
; combo3F.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combo3F/
  clipId          78            ; [real] ANM_hero.bin act id
  duration        1.4000s       ; [real] 42 frames @30
  blendIn         0.09s        ; [real] act header +0x04
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x78440       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/combo3F/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.28s        ; input buffered from here
  branchPoint     0.98s        ; queued branch executes
  cancelOpens     0.70s        ; L1 block-cancel window

/Combat/goHero/combo3F/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.70..1.40]s  [inferred]  ; block-cancel recovery
