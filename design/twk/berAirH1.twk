; =====================================================================
; berAirH1.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berAirH1/
  clipId          22            ; [real] ANM_hero.bin act id
  duration        0.6667s       ; [real] 20 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x25D80       ; [real] offset in ANM_hero.bin

/Combat/goHero/berAirH1/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.13s        ; input buffered from here
  branchPoint     0.47s        ; queued branch executes
  cancelOpens     0.33s        ; L1 block-cancel window

/Combat/goHero/berAirH1/Branches/
  branch  input=SQUARE         -> berAirH2         queueWindow=[0.13..0.67]s  targetDur=0.833s  [real-topology]  ; rage air 2
  cancel  input=L1             -> block            window=[0.33..0.67]s  [inferred]  ; block-cancel recovery
