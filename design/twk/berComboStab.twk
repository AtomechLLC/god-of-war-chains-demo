; =====================================================================
; berComboStab.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berComboStab/
  clipId          37            ; [real] ANM_hero.bin act id
  duration        1.7000s       ; [real] 51 frames @30
  blendIn         0.06s        ; [real] act header +0x04
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x35A80       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/berComboStab/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.34s        ; input buffered from here
  branchPoint     1.19s        ; queued branch executes
  cancelOpens     0.85s        ; L1 block-cancel window

/Combat/goHero/berComboStab/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.85..1.70]s  [inferred]  ; block-cancel recovery
