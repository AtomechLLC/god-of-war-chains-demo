; =====================================================================
; berJumpAir.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/berJumpAir/
  clipId          43            ; [real] ANM_hero.bin act id
  duration        0.3333s       ; [real] 10 frames @30
  blendIn         0s        ; [real] act header +0x04 (hard cut)
  keyframeRate    15Hz         ; [real] sample interval
  anmHeader       0x3E880       ; [real] offset in ANM_hero.bin
  looping         true          ; stance

/Combat/goHero/berJumpAir/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.07s        ; input buffered from here
  branchPoint     0.23s        ; queued branch executes
  cancelOpens     0.17s        ; L1 block-cancel window

/Combat/goHero/berJumpAir/Branches/
  branch  input=SQUARE         -> berAirH1         queueWindow=[0.07..0.33]s  targetDur=0.667s  [real-topology]  ; rage air chain
  branch  input=TRIANGLE       -> berAirV2         queueWindow=[0.07..0.33]s  targetDur=0.600s  [real-topology]  ; rage air slam
