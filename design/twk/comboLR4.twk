; =====================================================================
; comboLR4.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/comboLR4/
  clipId          90            ; [real] ANM_hero.bin act id
  duration        1.3333s       ; [real] 40 frames @30
  blendIn         0s        ; [real] act header +0x04 (hard cut)
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x97D40       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/comboLR4/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.27s        ; input buffered from here
  branchPoint     0.93s        ; queued branch executes
  cancelOpens     0.67s        ; L1 block-cancel window

/Combat/goHero/comboLR4/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.67..1.33]s  [inferred]  ; block-cancel recovery
