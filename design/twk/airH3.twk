; =====================================================================
; airH3.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/airH3/
  clipId          8            ; [real] ANM_hero.bin act id
  duration        0.8667s       ; [real] 26 frames @30
  blendIn         0s        ; [real] act header +0x04 (hard cut)
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0xA3C0       ; [real] offset in ANM_hero.bin
  chainEnder      true          ; recovers to stance

/Combat/goHero/airH3/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.17s        ; input buffered from here
  branchPoint     0.61s        ; queued branch executes
  cancelOpens     0.43s        ; L1 block-cancel window

/Combat/goHero/airH3/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.43..0.87]s  [inferred]  ; block-cancel recovery
