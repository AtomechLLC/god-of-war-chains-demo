; =====================================================================
; comboLR3.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/comboLR3/
  clipId          89            ; [real] ANM_hero.bin act id
  duration        1.1667s       ; [real] 35 frames @30
  blendIn         0s        ; [real] act header +0x04 (hard cut)
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x94580       ; [real] offset in ANM_hero.bin
  moveName        "Plume of Prometheus"  ; [real] from msgs_en.txt move list
  chainEnder      true          ; recovers to stance

/Combat/goHero/comboLR3/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.23s        ; input buffered from here
  branchPoint     0.82s        ; queued branch executes
  cancelOpens     0.58s        ; L1 block-cancel window

/Combat/goHero/comboLR3/Branches/
  (none — recovers to stance)
  cancel  input=L1             -> block            window=[0.58..1.17]s  [inferred]  ; block-cancel recovery
