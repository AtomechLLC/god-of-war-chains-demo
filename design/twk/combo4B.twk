; =====================================================================
; combo4B.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combo4B/
  clipId          80            ; [real] ANM_hero.bin act id
  duration        1.5333s       ; [real] 46 frames @30
  blendIn         0.09s        ; [real] act header +0x04
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x7EF80       ; [real] offset in ANM_hero.bin

/Combat/goHero/combo4B/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.31s        ; input buffered from here
  branchPoint     1.07s        ; queued branch executes
  cancelOpens     0.77s        ; L1 block-cancel window

/Combat/goHero/combo4B/Branches/
  branch  input=TRIANGLE       -> combo4C          queueWindow=[0.31..1.53]s  targetDur=1.333s  [real-topology]  ; heavy chain 3
  branch  input=SQUARE         -> combo6A          queueWindow=[0.31..1.53]s  targetDur=1.433s  [inferred]  ; mixed string
  cancel  input=L1             -> block            window=[0.77..1.53]s  [inferred]  ; block-cancel recovery
