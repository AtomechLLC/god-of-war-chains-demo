; =====================================================================
; combo5A.twk — reconstructed designer tweak sheet (God of War 1, hero)
; Data provenance: [real] = decoded from disc data, [inferred] = model
; =====================================================================

/Animation/goHero/combo5A/
  clipId          83            ; [real] ANM_hero.bin act id
  duration        1.1333s       ; [real] 34 frames @30
  blendIn         0.09s        ; [real] act header +0x04
  keyframeRate    30Hz         ; [real] sample interval
  anmHeader       0x86500       ; [real] offset in ANM_hero.bin

/Combat/goHero/combo5A/Windows/          ; [inferred] adjustable model —
  ; exact per-move windows are compiled into engine code, not data
  queueOpens      0.23s        ; input buffered from here
  branchPoint     0.79s        ; queued branch executes
  cancelOpens     0.57s        ; L1 block-cancel window

/Combat/goHero/combo5A/Branches/
  branch  input=SQUARE         -> combo5B          queueWindow=[0.23..1.13]s  targetDur=1.067s  [real-topology]  ; mixed string 2
  cancel  input=L1             -> block            window=[0.57..1.13]s  [inferred]  ; block-cancel recovery
